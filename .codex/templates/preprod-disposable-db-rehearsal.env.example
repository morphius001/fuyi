# Prefer creating the private draft with:
#   ./.codex/scripts/china-preprod-disposable-db-rehearsal-init-env.sh
#
# Then fill the placeholders, validate the file, and run the guarded rehearsal:
#   CODEX_PREPROD_DISPOSABLE_DATABASE_URL=<approved-redacted-url> \
#     ./.codex/scripts/china-preprod-disposable-db-rehearsal-apply-current-env.sh <path-to-private-env-file>
#   ./.codex/scripts/china-preprod-disposable-db-rehearsal-env-status.sh <path-to-private-env-file>
#   ./.codex/scripts/china-preprod-disposable-db-rehearsal-from-env.sh <path-to-private-env-file> validate
#   ./.codex/scripts/china-preprod-disposable-db-rehearsal-from-env.sh <path-to-private-env-file> run
#   PAYMENT_REFUND_SETTLEMENT_RUNTIME_APPROVED=true \
#     ./.codex/scripts/china-preprod-disposable-db-rehearsal-close-gate.sh run <path-to-private-env-file>
#
# Do not commit the filled env file. The database must be disposable,
# rebuildable, and contain no production data.

CODEX_PREPROD_DISPOSABLE_DATABASE_URL=postgres://user@preprod-host.example:5432/fuyi_preprod_disposable_YYYYMMDD
CODEX_PREPROD_DISPOSABLE_DB_CONFIRM=I_CONFIRM_THIS_IS_DISPOSABLE_PREPROD_DB
CODEX_PREPROD_DISPOSABLE_DB_BACKUP_CONFIRM=BACKUP_DONE_OR_NOT_NEEDED
CODEX_PREPROD_DISPOSABLE_DB_OPERATOR=replace-with-operator-or-ticket
CODEX_PREPROD_DISPOSABLE_DB_CLEANUP_OWNER=replace-with-cleanup-owner-or-ticket
CODEX_PREPROD_DISPOSABLE_WORKTREE_ACK=I_ACCEPT_CURRENT_LOCAL_WIP_FOR_REHEARSAL

# Optional only when the disposable preprod DB is exposed through a localhost tunnel.
# CODEX_PREPROD_DISPOSABLE_DB_LOCALHOST_PREPROD_TUNNEL_CONFIRM=I_CONFIRM_LOCALHOST_ENDPOINT_IS_DISPOSABLE_PREPROD_TUNNEL

# Optional only when the disposable preprod DB name needs a custom allowlist.
# CODEX_PREPROD_DISPOSABLE_DB_NAME_ALLOW_REGEX=^fuyi_preprod_disposable_[A-Za-z0-9_]+$
# CODEX_PREPROD_DISPOSABLE_DB_NAME_ALLOW_REGEX_CONFIRM=I_ACCEPT_CUSTOM_DB_NAME_ALLOW_REGEX
